# Copy to .env and edit. The .env file is git-ignored.

# Port the bridge listens on (must match the extension's Bridge URL setting).
PORT=19950

# Where downloaded models are written.
# Use any path you control — an external drive or network mount works fine.
STORAGE_DIR=./vault

# local  — write files on this machine (default)
# remote — hand the manifest to another host (see docs/REMOTE.md)
STORAGE_MODE=local

# Parallel downloads. Please keep this modest; it is load on someone else's service.
WORKERS=4
