{
  "manifest_version": 3,
  "name": "Meshy Asset Vault",
  "version": "2.0.0",
  "description": "Bulk-download your Meshy 3D models and creators you follow — GLB, FBX, OBJ and rigged animations — with a resumable local pipeline.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "downloads",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.meshy.ai/*",
    "https://api.meshy.ai/*",
    "https://assets.meshy.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meshy Asset Vault",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.meshy.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
